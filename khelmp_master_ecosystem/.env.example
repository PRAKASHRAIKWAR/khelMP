# Copy this to .env and replace the placeholders. Never commit .env.
DJANGO_SECRET_KEY=generate-a-new-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_MODEL_FALLBACKS=gemini-flash-latest,gemini-3.7-flash,gemini-3.5-flash,gemini-2.5-flash
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=your_twilio_phone_number
OTP_RETURN_CODE_IN_DEBUG=True
KHELMP_API_URL=http://127.0.0.1:8001
JWT_SECRET_KEY=generate-a-separate-random-secret
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
POSTGRES_USER=khelmp
POSTGRES_PASSWORD=change-this-local-development-password
POSTGRES_DB=khelmp
# Gmail SMTP for selector invitation delivery. Use a Google App Password, not your Gmail password.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
EMAIL_TIMEOUT=15
